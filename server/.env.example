# Copy to .env and adjust for your deployment. .env is gitignored.
# The app reads these directly from the environment; there is no dotenv loader,
# so either `export` them or use `env $(cat .env | xargs) npm start` — the
# deploy/start.sh script sources this file for you.

# Express listen port. nginx proxies /api to this. Default: 3000
PORT=3000

# Interface Express binds to. Default: 127.0.0.1 (loopback only — nginx is the
# public entry point). Set 0.0.0.0 only if you need to reach :3000 directly
# from another device on the LAN.
HOST=127.0.0.1

# Where the SQLite file lives. Keep it OUTSIDE the git clone so updates can
# never disturb it. Default (unset): <repo>/server/data/app.db
DB_PATH=/data/data/com.termux/files/home/gym-tracker-data/app.db

# Session signing secret. CHANGE THIS to a long random string in production
# (e.g. `openssl rand -hex 32` or `node -e "console.log(crypto.randomUUID())"`).
# If unset the app falls back to an insecure dev default.
SESSION_SECRET=change-me-to-a-long-random-string
