# Copy to .env for local development. .env is gitignored.
# The app reads these directly from the environment; there is no dotenv loader,
# so `export` them or run:  env $(cat .env | xargs) npm start
#
# In the cloud (Render) these are set as dashboard environment variables, not
# from a file — see DEPLOYMENT-CLOUD.md.

# --- database ---------------------------------------------------------------
# LOCAL DEV: leave both unset. The app uses a local file at server/data/app.db
# (libSQL reads a plain file with the same client it uses for Turso), so no
# account or network is needed to develop or run smoke.sh.
#
# CLOUD: set both. From the Turso dashboard for your database:
# TURSO_DATABASE_URL=libsql://gym-tracker-<org>.turso.io
# TURSO_AUTH_TOKEN=<secret token — never commit>

# Override the local file location (ignored when TURSO_DATABASE_URL is set):
# DB_PATH=/absolute/path/to/app.db

# --- server ----------------------------------------------------------------
# Listen port. Unset -> 3000. The cloud host injects its own PORT.
# PORT=3000

# Bind address. Unset -> 127.0.0.1 (loopback). The cloud host sets 0.0.0.0.
# HOST=127.0.0.1

# Session signing secret. Required when NODE_ENV=production (the app refuses to
# boot with the dev default). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=change-me-to-a-long-random-string

# --- AI coach recap (optional) ----------------------------------------------
# Unset -> the feature is hidden and no AI calls are made. A free key comes from
# Google AI Studio (aistudio.google.com). Never commit it.
# GEMINI_API_KEY=<secret>
# AI_MODEL=gemini-3.5-flash

# --- email: data export + forgot password (optional) -------------------------
# Unset -> the "Send email" option on Settings > Export data is hidden, and
# Forgot password says reset by email is not set up.
#
# Brevo (recommended, free 300/day): emails any address you type, no domain
# needed. In Brevo verify one sender address (Senders, Domains & Dedicated IPs
# > Senders), then create an API key (SMTP & API > API keys). Never commit it.
# BREVO_API_KEY=<secret>
# EMAIL_FROM=Gym Tracker <you@gmail.com>   # must be the verified sender
#
# Or Resend: emailing anyone needs a domain you own verified in Resend; without
# one, its test sender only delivers to the Resend account's own email.
# RESEND_API_KEY=<secret>
# EMAIL_FROM=Gym Tracker <export@yourdomain.com>

# Public address of the app, used to build the link in a password reset email
# (no trailing slash). Not needed locally, and on Render the service's own
# RENDER_EXTERNAL_URL is used automatically. Set it for a custom domain.
# APP_URL=https://gym.example.com
