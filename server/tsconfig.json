{
  // Type-checking only — no TypeScript files, no build output. `npm run
  // typecheck` runs `tsc --noEmit` over the plain-JS server with JSDoc as the
  // type source. Catches real bugs (wrong arg types, typos, dead branches)
  // without changing the runtime or the syntax.
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.js", "test/unit/**/*.js"]
}
